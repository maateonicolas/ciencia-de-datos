# Copy to .env locally; never commit credentials.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_AUTHENTICATOR=snowflake
# Optional key-pair authentication; local absolute path, mounted path in Compose.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Required only for local Docker Compose; choose a private local value.
KESTRA_POSTGRES_PASSWORD=
